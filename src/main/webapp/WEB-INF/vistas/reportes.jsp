<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*" %><% List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("resumen"); %><!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>Reportes | CEKALIX</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><%@ include file="partials/nav.jspf" %><main class="wrap"><span class="eyebrow">ADMINISTRACIÓN</span><h1>Reportes de ventas</h1><section class="stats"><div class="stat"><span>Ventas emitidas</span><strong><%=request.getAttribute("cantidadVentas")%></strong></div><div class="stat"><span>Importe acumulado</span><strong>S/ <%=request.getAttribute("totalVentas")%></strong></div></section><section class="panel"><h2>Últimos 30 días</h2><table><thead><tr><th>Fecha</th><th>N.º ventas</th><th>Total</th></tr></thead><tbody><% for(Map<String,Object> x:rows){ %><tr><td><%=x.get("dia")%></td><td><%=x.get("cantidad")%></td><td>S/ <%=x.get("total")%></td></tr><% } %></tbody></table></section></main></body></html>
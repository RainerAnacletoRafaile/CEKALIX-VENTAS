<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.cekalix.modelo.Usuario" %><% List<Usuario> rows=(List<Usuario>)request.getAttribute("usuarios");String err=(String)session.getAttribute("error");session.removeAttribute("error"); %><!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>Usuarios | CEKALIX</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><%@ include file="partials/nav.jspf" %><main class="wrap"><h1>Administración de usuarios</h1><% if(err!=null){ %><div class="alert"><%=err%></div><% } %><section class="panel"><h2>Crear usuario</h2><form class="formgrid" method="post"><input name="nombre" placeholder="Nombre completo" required><input name="usuario" placeholder="Usuario" required><input name="clave" type="password" minlength="8" placeholder="Contraseña (mín. 8 caracteres)" required><select name="rol"><option value="VENDEDOR">Vendedor</option><option value="ADMINISTRADOR">Administrador</option></select><button class="btn primary">Crear usuario</button></form></section><section class="panel"><h2>Usuarios activos</h2><table><thead><tr><th>Nombre</th><th>Usuario</th><th>Rol</th></tr></thead><tbody><% for(Usuario x:rows){ %><tr><td><%=x.getNombre()%></td><td><%=x.getUsuario()%></td><td><%=x.getRol()%></td></tr><% } %></tbody></table></section></main></body></html>
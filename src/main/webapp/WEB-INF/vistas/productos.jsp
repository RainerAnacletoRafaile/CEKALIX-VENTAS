<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.cekalix.modelo.Producto" %><% List<Producto> rows=(List<Producto>)request.getAttribute("productos"); %><!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>Productos | CEKALIX</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><%@ include file="partials/nav.jspf" %><main class="wrap"><span class="eyebrow">CATÁLOGO</span><h1>Productos</h1><p class="muted">Control de productos, precios y existencias.</p><section class="panel"><h2>Registrar producto</h2><form class="formgrid" method="post"><input name="sku" placeholder="SKU / Código" required><input name="nombre" placeholder="Nombre del producto" required><input name="precio" type="number" min="0" step=".01" placeholder="Precio S/" required><input name="stock" type="number" min="0" placeholder="Stock inicial" required><input class="wide" name="descripcion" placeholder="Descripción"><button class="btn primary">Guardar producto</button></form></section><section class="panel"><h2>Catálogo registrado</h2><div class="tablewrap"><table><thead><tr><th>SKU</th><th>Producto</th><th>Descripción</th><th>Precio</th><th>Stock</th></tr></thead><tbody><% if(rows==null||rows.isEmpty()){ %><tr><td colspan="5">No hay productos.</td></tr><% }else for(Producto x:rows){ %><tr><td><%=x.getSku()%></td><td><%=x.getNombre()%></td><td><%=x.getDescripcion()==null?"—":x.getDescripcion()%></td><td>S/ <%=x.getPrecio()%></td><td><span class="pill"><%=x.getStock()%></span></td></tr><% } %></tbody></table></div></section></main></body></html>
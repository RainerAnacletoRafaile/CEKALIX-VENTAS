<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="com.cekalix.modelo.Usuario" %><% Usuario u=(Usuario)session.getAttribute("usuarioSesion"); %><!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Panel | CEKALIX</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><%@ include file="partials/nav.jspf" %><main class="wrap"><section class="panel"><span class="eyebrow">PANEL DE CONTROL</span><h1>¡Bienvenido, <%=u.getNombre()%>!</h1><p class="muted">Gestiona las operaciones comerciales de CEKALIX S.A.C.</p><a class="btn success" href="<%=request.getContextPath()%>/ventas">＋ Registrar venta</a></section><section class="stats"><a class="stat" href="<%=request.getContextPath()%>/clientes"><strong>Clientes</strong><span>Registrar y consultar clientes</span></a><a class="stat" href="<%=request.getContextPath()%>/productos"><strong>Productos</strong><span>Catálogo, precios y stock</span></a><a class="stat" href="<%=request.getContextPath()%>/ventas"><strong>Ventas</strong><span>Registrar y consultar ventas</span></a><% if("ADMINISTRADOR".equals(u.getRol())){ %><a class="stat" href="<%=request.getContextPath()%>/usuarios"><strong>Usuarios</strong><span>Administrar accesos y roles</span></a><a class="stat" href="<%=request.getContextPath()%>/reportes"><strong>Reportes</strong><span>Resumen comercial</span></a><% } %></section></main></body></html>
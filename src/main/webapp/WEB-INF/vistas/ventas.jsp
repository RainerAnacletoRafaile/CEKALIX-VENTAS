<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.cekalix.modelo.*" %><% List<Venta> ventas=(List<Venta>)request.getAttribute("ventas");List<Cliente> clientes=(List<Cliente>)request.getAttribute("clientes");List<Producto> productos=(List<Producto>)request.getAttribute("productos");String msg=(String)session.getAttribute("mensaje"),err=(String)session.getAttribute("error");session.removeAttribute("mensaje");session.removeAttribute("error"); %><!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>Ventas | CEKALIX</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><%@ include file="partials/nav.jspf" %><main class="wrap"><span class="eyebrow">OPERACIONES COMERCIALES</span><h1>Registro de ventas</h1><p class="muted">Registra una venta, valida el stock y actualiza el inventario automáticamente.</p><% if(msg!=null){ %><div class="successbox"><%=msg%></div><% }if(err!=null){ %><div class="alert"><%=err%></div><% } %><section class="panel"><h2>Nueva venta</h2><form method="post"><div class="formgrid"><select name="clienteId" required><option value="">Selecciona cliente</option><% for(Cliente c:clientes){ %><option value="<%=c.getIdCliente()%>"><%=c.getRazonSocial()%></option><% } %></select><select name="tipoComprobante"><option value="BOLETA">Boleta interna</option><option value="FACTURA">Factura interna</option></select><select name="metodoPago"><option>EFECTIVO</option><option>TRANSFERENCIA</option><option>TARJETA</option><option>YAPE/PLIN</option></select></div><div id="items"><div class="sale-row"><select name="productoId" required><option value="">Selecciona producto</option><% for(Producto x:productos){ %><option value="<%=x.getIdProducto()%>"><%=x.getSku()%> · <%=x.getNombre()%> (stock <%=x.getStock()%>)</option><% } %></select><input name="cantidad" type="number" min="1" value="1" required></div></div><button type="button" class="btn light" onclick="addRow()">＋ Añadir producto</button> <button class="btn success">Registrar venta</button></form></section><section class="panel"><h2>Historial de ventas</h2><div class="tablewrap"><table><thead><tr><th>Comprobante</th><th>Fecha</th><th>Cliente</th><th>Pago</th><th>Total</th><th>Estado</th></tr></thead><tbody><% if(ventas==null||ventas.isEmpty()){ %><tr><td colspan="6">No hay ventas registradas.</td></tr><% }else for(Venta v:ventas){ %><tr><td><%=v.getComprobante()%> · <%=v.getNumero()%></td><td><%=v.getFecha()%></td><td><%=v.getCliente()%></td><td><%=v.getMetodoPago()%></td><td>S/ <%=v.getTotal()%></td><td><span class="pill"><%=v.getEstado()%></span></td></tr><% } %></tbody></table></div></section></main><script>function addRow(){let f=document.querySelector('.sale-row'),r=f.cloneNode(true);r.querySelector('select').value='';r.querySelector('input').value='1';document.getElementById('items').appendChild(r)}</script></body></html>
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.cekalix.modelo.*" %><% List<Map<String,Object>> cot=(List<Map<String,Object>>)request.getAttribute("cotizaciones");List<Cliente> clientes=(List<Cliente>)request.getAttribute("clientes");List<Producto> productos=(List<Producto>)request.getAttribute("productos");String msg=(String)session.getAttribute("mensaje"),err=(String)session.getAttribute("error");session.removeAttribute("mensaje");session.removeAttribute("error"); %><!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>Cotizaciones | CEKALIX</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><%@ include file="partials/nav.jspf" %><main class="wrap"><span class="eyebrow">GESTIÓN COMERCIAL</span><h1>Cotizaciones</h1><p class="muted">Prepara propuestas comerciales sin afectar el inventario.</p><% if(msg!=null){ %><div class="successbox"><%=msg%></div><% }if(err!=null){ %><div class="alert"><%=err%></div><% } %><section class="panel"><h2>Nueva cotización</h2><form method="post"><select name="clienteId" required><option value="">Selecciona cliente</option><% for(Cliente c:clientes){ %><option value="<%=c.getIdCliente()%>"><%=c.getRazonSocial()%></option><% } %></select><div id="items"><div class="sale-row"><select name="productoId" required><option value="">Producto</option><% for(Producto x:productos){ %><option value="<%=x.getIdProducto()%>"><%=x.getSku()%> · <%=x.getNombre()%> (S/ <%=x.getPrecio()%>)</option><% } %></select><input name="cantidad" type="number" min="1" value="1" required></div></div><button type="button" class="btn light" onclick="addRow()">＋ Añadir producto</button> <button class="btn primary">Guardar cotización</button></form></section><section class="panel"><h2>Cotizaciones registradas</h2><table><thead><tr><th>Código</th><th>Fecha</th><th>Cliente</th><th>Asesor</th><th>Total</th><th>Estado</th></tr></thead><tbody><% if(cot==null||cot.isEmpty()){ %><tr><td colspan="6">No hay cotizaciones registradas.</td></tr><% }else for(Map<String,Object> x:cot){ %><tr><td>COT-<%=x.get("id")%></td><td><%=x.get("fecha")%></td><td><%=x.get("cliente")%></td><td><%=x.get("usuario")%></td><td>S/ <%=x.get("total")%></td><td><span class="pill"><%=x.get("estado")%></span></td></tr><% } %></tbody></table></section></main><script>function addRow(){let f=document.querySelector('.sale-row'),r=f.cloneNode(true);r.querySelector('select').value='';r.querySelector('input').value='1';document.getElementById('items').appendChild(r)}</script></body></html>
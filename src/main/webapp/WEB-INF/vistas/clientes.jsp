<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.cekalix.modelo.Cliente" %><% List<Cliente> rows=(List<Cliente>)request.getAttribute("clientes"); %><!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>Clientes | CEKALIX</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><%@ include file="partials/nav.jspf" %><main class="wrap"><span class="eyebrow">GESTIÓN COMERCIAL</span><h1>Clientes</h1><p class="muted">Registro y consulta de clientes.</p><section class="panel"><h2>Registrar cliente</h2><form class="formgrid" method="post"><select name="tipo"><option>EMPRESA</option><option>PERSONA</option></select><input name="razonSocial" placeholder="Razón social / nombre" required><input name="ruc" placeholder="RUC o documento (opcional)"><input name="telefono" placeholder="Teléfono"><input name="correo" type="email" placeholder="Correo"><input name="contacto" placeholder="Persona de contacto"><input class="wide" name="direccion" placeholder="Dirección"><button class="btn primary">Guardar cliente</button></form></section><section class="panel"><h2>Clientes registrados</h2><div class="tablewrap"><table><thead><tr><th>Tipo</th><th>Razón social</th><th>Documento</th><th>Teléfono</th><th>Correo</th></tr></thead><tbody><% if(rows==null||rows.isEmpty()){ %><tr><td colspan="5">Aún no hay clientes.</td></tr><% }else for(Cliente x:rows){ %><tr><td><%=x.getTipoCliente()%></td><td><%=x.getRazonSocial()%></td><td><%=x.getRuc()==null?"—":x.getRuc()%></td><td><%=x.getTelefono()==null?"—":x.getTelefono()%></td><td><%=x.getCorreo()==null?"—":x.getCorreo()%></td></tr><% } %></tbody></table></div></section></main></body></html>
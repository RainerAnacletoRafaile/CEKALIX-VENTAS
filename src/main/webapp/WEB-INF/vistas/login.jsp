<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Acceso | CEKALIX</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body class="login-bg"><main class="login-card"><div class="brand">CEKALIX <span>S.A.C.</span></div><p class="eyebrow">SISTEMA WEB DE VENTAS</p><h1>Bienvenido</h1><p class="muted">Ingresa tus credenciales para continuar.</p><% if(request.getAttribute("error")!=null){ %><div class="alert"><%=request.getAttribute("error")%></div><% } %><form method="post" action="<%=request.getContextPath()%>/login"><label>Usuario</label><input name="usuario" autocomplete="username" required autofocus><label>Contraseña</label><input type="password" name="clave" autocomplete="current-password" required><button class="btn primary full">Ingresar al sistema →</button></form><small>Acceso inicial: admin / admin123</small></main></body></html>
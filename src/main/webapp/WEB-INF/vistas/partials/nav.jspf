<%@ page import="com.cekalix.modelo.Usuario" %><% Usuario navUser=(Usuario)session.getAttribute("usuarioSesion"); %><header class="topbar"><a class="brand" href="<%=request.getContextPath()%>/inicio">CEKALIX <span>S.A.C.</span></a><nav><a href="<%=request.getContextPath()%>/inicio">Panel</a><a href="<%=request.getContextPath()%>/clientes">Clientes</a><a href="<%=request.getContextPath()%>/productos">Productos</a><a href="<%=request.getContextPath()%>/cotizaciones">Cotizaciones</a><a href="<%=request.getContextPath()%>/ventas">Ventas</a><% if(navUser!=null&&"ADMINISTRADOR".equals(navUser.getRol())){ %><a href="<%=request.getContextPath()%>/usuarios">Usuarios</a><a href="<%=request.getContextPath()%>/reportes">Reportes</a><% } %></nav><div class="userbox"><%=navUser==null?"":navUser.getNombre()%> · <a href="<%=request.getContextPath()%>/cerrar-sesion">Salir</a></div></header>